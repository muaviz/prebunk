{
  "manifest_version": 3,
  "name": "Prebunk — Spot the Lie",
  "version": "1.0.0",
  "description": "Highlight suspicious text and instantly get a fact-based response. Powered by Prebunk's anti-misinformation taxonomy.",
  "permissions": ["contextMenus", "activeTab", "storage", "sidePanel"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*", "https://*.onrender.com/*", "https://prebunk-api.railway.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Open Prebunk Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
